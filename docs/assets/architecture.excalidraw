      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "render tiles\n16x16 block, 256-Gaussian\nshared-mem batches,\nalpha blend, T < 1e-4"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-10-10T02:20:20.338Z",
