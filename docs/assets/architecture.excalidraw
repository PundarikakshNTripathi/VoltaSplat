      "strokeColor": "#1971c2",
      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "duplicate with keys\none (tile << 32 | depth)\nkey per overlapped tile"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
