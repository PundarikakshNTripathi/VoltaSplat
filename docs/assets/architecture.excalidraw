      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "preprocess kernel\nEWA: J W S W^T J^T + 0.3 I\nconic, 3-sigma radius,\ntile rectangle"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
