      "backgroundColor": "#ffe8cc",
      "strokeColor": "#e8590c",
      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "render backward\nreverse traversal\nT = T / (1 - alpha)\natomicAdd: d mean2D,\nd conic, d color, d opacity"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
